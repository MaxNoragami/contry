CONTRY_ENV_FILE=.env.dev
COMPOSE_PROFILES=dev

ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_HTTP_PORT=8080
CLIENT_HTTP_PORT=5173

POSTGRES_DB=contry_dev
POSTGRES_USER=contry
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432
CONTRY_DB_HOST=db

ConnectionStrings__Database=Host=localhost;Port=5432;Database=contry_dev;Username=contry;Password=change_me
DOCKER_ConnectionStrings__Database=Host=db;Port=5432;Database=contry_dev;Username=contry;Password=change_me
DOCKER_VITE_API_BASE_URL=/
VITE_API_BASE_URL=http://localhost:8080

AdminBootstrap__Username=admin
AdminBootstrap__Email=admin@example.com
AdminBootstrap__Password=change-me-admin-password

Jwt__Issuer=contry-api
Jwt__Audience=contry-client
Jwt__Secret=replace-with-a-long-random-secret
Jwt__AccessTokenLifetimeMinutes=1
Jwt__RefreshTokenLifetimeMinutes=5

AuthCookies__AccessCookieName=contry_access
AuthCookies__RefreshCookieName=contry_refresh
AuthCookies__Domain=
AuthCookies__Path=/
AuthCookies__SameSite=Lax
AuthCookies__SecurePolicy=SameAsRequest
DOCKER_AuthCookies__Domain=
DOCKER_AuthCookies__SecurePolicy=SameAsRequest

Cors__AllowedOriginsCsv=http://localhost:5173,https://*.ngrok-free.app
DOCKER_Cors__AllowedOriginsCsv=http://localhost:5173
RENDER_EXTERNAL_URL=http://localhost:8080
